# --- LLM (local, free) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
WARIS_EMBEDDINGS=auto      # auto | ollama (nomic-embed-text) | hash (offline fallback)
WARIS_USE_LLM=1            # 0 = deterministic fallbacks only (demo-safe)

# --- Mock portals ---
PORTAL_URL=http://127.0.0.1:8001

# --- Limits (every loop is bounded) ---
WARIS_MAX_ROUNDS=6         # Verifier send-back rounds per case
WARIS_MAX_REQUERY=2        # RAG re-queries per asset per need
WARIS_MAX_TRACER_STEPS=8
WARIS_MAX_LLM_CALLS=40
WARIS_TOOL_TIMEOUT=10

# --- Langfuse (optional; local JSONL + HTML trace is always written) ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-waris-demo
LANGFUSE_SECRET_KEY=sk-lf-waris-demo
